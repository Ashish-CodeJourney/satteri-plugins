{
  "name": "satteri-github",
  "version": "0.0.0",
  "description": "S\u00e4tteri plugin to autolink GitHub references \u2014 a port of remark-github.",
  "keywords": [
    "satteri",
    "satteri-plugin",
    "mdast",
    "markdown",
    "mdx",
    "astro",
    "github",
    "autolink",
    "issue",
    "commit",
    "remark-github"
  ],
  "license": "MIT",
  "author": "Ashish Vaghela <ashish.vaghela@nelkinda.com> (https://ashish-codejourney.github.io/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashish-CodeJourney/satteri-plugins.git",
    "directory": "packages/satteri-github"
  },
  "homepage": "https://github.com/Ashish-CodeJourney/satteri-plugins/tree/main/packages/satteri-github#readme",
  "bugs": "https://github.com/Ashish-CodeJourney/satteri-plugins/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "satteri": "^0.9.5"
  },
  "devDependencies": {
    "@satteri-plugins/test-kit": "workspace:*",
    "@types/hast": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
