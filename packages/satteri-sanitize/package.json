{
  "name": "satteri-sanitize",
  "version": "0.0.0",
  "description": "Sätteri plugin to sanitize HTML in Markdown — a port of rehype-sanitize.",
  "keywords": [
    "satteri",
    "satteri-plugin",
    "hast",
    "markdown",
    "mdx",
    "astro",
    "sanitize",
    "xss",
    "security",
    "rehype-sanitize"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashish-CodeJourney/satteri-plugins.git",
    "directory": "packages/satteri-sanitize"
  },
  "homepage": "https://github.com/Ashish-CodeJourney/satteri-plugins/tree/main/packages/satteri-sanitize#readme",
  "bugs": "https://github.com/Ashish-CodeJourney/satteri-plugins/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "satteri": "^0.9.5"
  },
  "devDependencies": {
    "@satteri-plugins/test-kit": "workspace:*",
    "@types/hast": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
