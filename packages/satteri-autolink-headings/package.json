{
  "name": "satteri-autolink-headings",
  "version": "0.0.0",
  "description": "Sätteri plugin to add links to headings — a port of rehype-autolink-headings.",
  "keywords": [
    "satteri",
    "satteri-plugin",
    "hast",
    "markdown",
    "mdx",
    "astro",
    "heading",
    "anchor",
    "autolink",
    "rehype-autolink-headings"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "satteri": "^0.9.5"
  },
  "devDependencies": {
    "@satteri-plugins/test-kit": "workspace:*",
    "@types/hast": "^3.0.5",
    "satteri-slug": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
