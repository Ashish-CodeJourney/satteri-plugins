{
  "name": "satteri-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @satteri-plugins/example-astro7-site test:e2e",
    "test:watch": "vitest",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "satteri": "^0.9.5",
    "tsdown": "^0.16.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
